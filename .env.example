# Copy this file to .env.local and fill in real values for local dev.
# Set the SAME keys in the Vercel dashboard → Settings → Environment Variables
# for Production — .env.local is NOT synced to Vercel automatically, and a
# missing prod env var is the #1 "works on localhost, 500s in prod" trap.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — https://openrouter.ai/keys (AI summary / quiz / interview
# simulator features). Free-tier models are used by default (lib/gemini.ts),
# so no billing is required to try these features.
OPENROUTER_API_KEY=

# Clerk — https://dashboard.clerk.com → API Keys (optional sign-in; the app
# is fully usable without it — see the Sign In button in the top-right).
# Personalized features (My Dashboard, quiz scoreboard entries) require it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
