# Copy this file to .env.local and fill in real values for local dev.
# Set the SAME keys in the Vercel dashboard → Settings → Environment Variables
# for Production — .env.local is NOT synced to Vercel automatically, and a
# missing prod env var is the #1 "works on localhost, 500s in prod" trap.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — https://aistudio.google.com/apikey (bonus AI summary feature)
GEMINI_API_KEY=

# Clerk — optional bonus auth, not wired up yet (see README "Auth (optional bonus)")
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
